{
  "name": "@cuelith-core/conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Suite di conformita' dei plugin: controlli sul pacchetto e prove con il motore vero.",
  "bin": {
    "cuelith-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "bundle": "vite build --config vite.bundle.config.ts"
  },
  "dependencies": {
    "@cuelith-core/engine": "workspace:*",
    "@cuelith/protocol": "link:../../../cuelith-sdk/packages/protocol",
    "fflate": "0.8.3",
    "semver": "7.8.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "vite": "8.3.1"
  }
}
